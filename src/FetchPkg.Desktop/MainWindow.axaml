<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FetchPkg.Desktop.MainWindow"
        Title="FetchPkg" Width="1220" Height="800" MinWidth="960" MinHeight="650">
  <Grid Margin="22" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="12">
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,2,0,4">
      <Border Width="44" Height="44" CornerRadius="12"
              Background="{DynamicResource AppAccentSoftBrush}" IsHitTestVisible="False">
        <PathIcon Width="23" Height="23" Foreground="{DynamicResource AppAccentBrush}"
                  Data="M 11,2 L 13,2 L 13,12 L 16.5,8.5 L 18,10 L 12,16 L 6,10 L 7.5,8.5 L 11,12 Z M 4,16 L 6,16 L 6,20 L 18,20 L 18,16 L 20,16 L 20,22 L 4,22 Z" />
      </Border>
      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="FetchPkg" FontSize="25" FontWeight="SemiBold" />
        <TextBlock Text="Package downloads · macOS / Linux / Windows" Classes="muted" FontSize="12" />
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Grid.RowSpan="2" Classes="panel" IsHitTestVisible="False" />
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="14,14,14,0">
      <TextBox x:Name="SourceBox" Watermark="Paste manifest or PKG URLs, one per line"
               AcceptsReturn="True" Height="76" TextWrapping="Wrap" VerticalContentAlignment="Top" />
      <StackPanel Grid.Column="1" Spacing="6">
        <Button Classes="action accent" Content="Add links" Click="AddLinks" HorizontalAlignment="Stretch" />
        <Button Classes="action" Content="Paste links" Click="PasteLinks" HorizontalAlignment="Stretch" />
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="2" Spacing="10" Margin="14,0,14,14">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <TextBlock Text="Save to" Classes="fieldLabel" VerticalAlignment="Center" />
        <TextBox x:Name="OutputBox" Grid.Column="1" />
        <Button Grid.Column="2" Classes="action" Content="Choose folder…" Click="ChooseFolder" />
      </Grid>
      <WrapPanel Orientation="Horizontal">
        <TextBlock Text="Connections" Classes="fieldLabel" VerticalAlignment="Center" Margin="0,0,8,0" />
        <NumericUpDown x:Name="ConnectionsBox" Minimum="1" Maximum="64" Increment="1"
                       FormatString="0" Width="110" Margin="0,0,18,0" />
        <TextBlock Text="Segment MiB" Classes="fieldLabel" VerticalAlignment="Center" Margin="0,0,8,0" />
        <NumericUpDown x:Name="SegmentBox" Minimum="1" Maximum="1024" Increment="1"
                       FormatString="0" Width="120" Margin="0,0,18,0" />
        <CheckBox x:Name="SparseBox" Content="Sparse files" Margin="0,0,18,0" />
        <CheckBox x:Name="VerifyBox" Content="Verify hashes" Margin="0,0,18,0" />
        <CheckBox x:Name="IgnoreSslBox" Content="Ignore SSL errors (unsafe)" />
      </WrapPanel>
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <TextBlock Text="HTTP proxy" Classes="fieldLabel" VerticalAlignment="Center" />
        <TextBox x:Name="ProxyBox" Grid.Column="1" Watermark="Optional: http://host:port" />
        <Button Grid.Column="2" Classes="action" Content="PROSPEROPatches ↗" Click="OpenPatches" />
      </Grid>
      <TextBlock Text="PROSPEROPatches opens in your browser. Copy the JSON or SC link, then use Paste links. SSL settings apply to downloads only."
                 Classes="muted" FontSize="11" LineHeight="16" TextWrapping="Wrap" />
    </StackPanel>
    <WrapPanel Grid.Row="3" Orientation="Horizontal">
      <Button Classes="action accent" Content="Start / retry selected" Click="StartSelected" Margin="0,0,8,0" />
      <Button Classes="action" Content="Pause" Click="PauseSelected" Margin="0,0,8,0" />
      <Button Classes="action" Content="Resume" Click="ResumeSelected" Margin="0,0,8,0" />
      <Button Classes="action" Content="Cancel" Click="CancelSelected" Margin="0,0,8,0" />
      <Button Classes="action" Content="Remove" Click="RemoveSelected" Margin="0,0,8,0" />
      <Button Classes="action" Content="Open folder" Click="OpenFolder" Margin="0,0,8,0" />
    </WrapPanel>
    <Border Grid.Row="4" Classes="panel" ClipToBounds="True">
      <DataGrid x:Name="JobsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                SelectionMode="Extended" GridLinesVisibility="Horizontal" RowHeight="42" Margin="1">
        <DataGrid.Columns>
          <DataGridTextColumn FontSize="12" Header="Package" Binding="{Binding Name}" Width="230" />
          <DataGridTextColumn FontSize="12" Header="Status" Binding="{Binding Status}" Width="105" />
          <DataGridTextColumn FontSize="12" Header="Progress" Binding="{Binding ProgressText}" Width="90" />
          <DataGridTextColumn FontSize="12" Header="Speed" Binding="{Binding Speed}" Width="105" />
          <DataGridTextColumn FontSize="12" Header="ETA" Binding="{Binding Eta}" Width="85" />
          <DataGridTextColumn FontSize="12" Header="Details" Binding="{Binding Details}" Width="*" MinWidth="220" />
          <DataGridTextColumn FontSize="12" Header="Source URL" Binding="{Binding SourceUrl}" Width="300" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
    <Grid Grid.Row="5" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="2,0,2,0">
      <Ellipse Width="6" Height="6" Fill="{DynamicResource AppAccentBrush}" VerticalAlignment="Center" />
      <TextBlock x:Name="StatusText" Grid.Column="1" Text="Ready. With no selection, Start runs all unfinished packages."
                 TextWrapping="Wrap" Classes="muted" FontSize="11" />
    </Grid>
  </Grid>
</Window>
